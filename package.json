{
  "name": "maintenance-tracker-scripts",
  "private": true,
  "description": "Admin-only tooling for the Maintenance Tracker PWA — not part of the deployed app itself (see README's \"3D model integration\" section).",
  "scripts": {
    "sync-assets:emulator": "FIRESTORE_EMULATOR_HOST=localhost:8080 node scripts/sync-assets.js",
    "sync-assets:live": "node scripts/sync-assets.js",
    "emulators": "firebase emulators:start --export-on-exit=./emulator-data --import=./emulator-data",
    "jobs-sample:export": "node scripts/export-jobs-sample.js",
    "jobs-sample:import": "FIRESTORE_EMULATOR_HOST=localhost:8080 node scripts/import-jobs-sample.js",
    "serve": "npx serve -l 5000 ."
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.36.0"
  }
}
