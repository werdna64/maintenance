rules_version = '2';

// Maintenance Tracker — Firestore Security Rules
// Rules version: 1 (2026-09-08)
//
// Bump the number and date above by one whenever this file changes, so
// after pasting into Firebase console → Firestore → Rules, you can
// check the line showing there against what you meant to paste before
// hitting Publish.
//
// Deploy with: firebase deploy --only firestore:rules
// (see README.md for full setup). Each person's role and display name
// are set by writing a document to /users/{uid} from the Firebase
// console — never from the app itself, so a signed-in user can never
// grant themselves a role or rename themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return profile().role;
    }

    function displayName() {
      return profile().name;
    }

    function isMaintenance() {
      return signedIn() && role() == 'maintenance';
    }

    function isHousekeeping() {
      return signedIn() && role() == 'housekeeping';
    }

    // A new job must be honestly attributed to whoever is actually
    // creating it (matching their real /users profile, not whatever the
    // client feels like asserting) and must start Open — the app's UI
    // already enforces this, but a direct API/SDK call bypassing the UI
    // must not be able to fabricate authorship or skip straight to a
    // later status.
    function isHonestJobCreate() {
      let d = request.resource.data;
      return d.createdByUid == request.auth.uid
          && d.createdByName == displayName()
          && d.updatedByUid == request.auth.uid
          && d.updatedByName == displayName()
          && d.status == 'Open';
    }

    // Notes are meant to be an append-only log — once a job has a notes
    // array, an update may only add to the end of it, never edit,
    // reorder, or remove an earlier entry. Jobs saved before notes had
    // individual entries still have a single legacy string, no notes
    // field at all, or an empty array (e.g. a PPM-generated job, which
    // starts with no notes yet to protect); there's nothing to protect
    // until the first note actually lands, so this only starts
    // enforcing from that point on.
    function notesAppendOnly() {
      return !('notes' in resource.data) || !(resource.data.notes is list)
          || resource.data.notes.size() == 0
          || (request.resource.data.notes is list
              && request.resource.data.notes.size() >= resource.data.notes.size()
              && request.resource.data.notes[0:resource.data.notes.size()] == resource.data.notes);
    }

    // Editing a job may change its own fields (status, issue, notes,
    // etc.) but can never rewrite who originally logged it or when —
    // that's the permanent part of the audit trail. Whoever is saving
    // right now must also be honestly attributed as the updater.
    function isHonestJobUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.createdByUid == before.createdByUid
          && after.createdByName == before.createdByName
          && after.dateLogged == before.dateLogged
          && after.updatedByUid == request.auth.uid
          && after.updatedByName == displayName()
          && notesAppendOnly();
    }

    // A walk session must be honestly attributed to whoever actually ran
    // it, same reasoning as isHonestJobCreate() above.
    function isHonestWalkCreate() {
      let d = request.resource.data;
      return d.conductedByUid == request.auth.uid
          && d.conductedByName == displayName();
    }

    // A deletion record must be honestly attributed to whoever actually
    // deleted the job, same reasoning as isHonestJobCreate() above.
    function isHonestDeleteLog() {
      let d = request.resource.data;
      return d.deletedByUid == request.auth.uid
          && d.deletedByName == displayName();
    }

    // Each person's account has a /users/{uid} doc naming their role and
    // display name. Only that account can read its own doc; nobody can
    // write one from the client — accounts are set up by hand in the
    // Firebase console.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Jobs: maintenance has full control. Housekeeping can log a new
    // problem report but can't edit or delete anything (including their
    // own reports) — corrections go through maintenance. Everyone signed
    // in (including management, read-only) can read the list. Create and
    // update both require honest self-attribution (see functions above)
    // so the "who did what, when" trail can't be forged by a client
    // talking to Firestore directly instead of through the app's UI.
    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if (isMaintenance() || isHousekeeping()) && isHonestJobCreate();
      allow update: if isMaintenance() && isHonestJobUpdate();
      allow delete: if isMaintenance();
    }

    // Rooms and site config (areas, site name) are maintenance-managed,
    // and only readable once signed in — the login screen shows a
    // generic name rather than fetching the real one, so this can stay
    // authenticated-only rather than exposing it publicly.
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isMaintenance();
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isMaintenance();
    }

    // Planned preventative maintenance task definitions (recurring
    // schedules) — Maintenance-managed, same as rooms/config. The jobs
    // PPM generates when due are ordinary /jobs documents (see above),
    // not stored here.
    match /ppmTasks/{taskId} {
      allow read: if signedIn();
      allow write: if isMaintenance();
    }

    // Walk sessions: a record that a Fire & Security Walk happened, one
    // per completed walk (including a fully "all in order" one — that's
    // the proof the walk was actually done). Same shape as jobs: anyone
    // signed in can read the history report; maintenance or housekeeping
    // can log one (honestly attributed to themselves); only maintenance
    // can correct/remove one afterwards.
    match /walks/{walkId} {
      allow read: if signedIn();
      allow create: if (isMaintenance() || isHousekeeping()) && isHonestWalkCreate();
      allow update, delete: if isMaintenance();
    }

    // Permanent record of why a job was deleted, since the job itself
    // won't exist afterwards to ask. Only maintenance can delete a job
    // (see /jobs above), so only maintenance ever writes here — and
    // once written, a record can never be edited or removed, same as
    // the rest of this app's audit trail.
    match /deletedJobs/{recordId} {
      allow read: if isMaintenance();
      allow create: if isMaintenance() && isHonestDeleteLog();
      allow update, delete: if false;
    }

    // Each person tracks their own "last checked notifications at" time,
    // used to work out what's new since they last looked. Purely
    // self-serve — nobody can read or write another person's marker.
    match /notificationState/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
